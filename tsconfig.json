{
	"compilerOptions": {
		"target": "ES2023",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"resolveJsonModule": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
